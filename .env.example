# Secret Server — example environment variables for local development.
# Copy to .env and adjust. NEVER commit .env with real secrets.

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://authenticator:authenticator@localhost:5432/secretserver
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/secretserver

# ── Secrets (CHANGE ALL in production) ────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
MASTER_KEY=dev-master-key-change-in-prod!!
SECRET_KEY=flask-session-secret-change-me

# ── PostgREST / shared cache ───────────────────────────────────────────
POSTGREST_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
REDIS_DEK_CACHE_TTL=300

# ── Bootstrap admin (promote this email once on first start) ──────────
GLOBAL_ADMIN_EMAIL=

# ── Dev only — skip insecure-default check ────────────────────────────
ALLOW_INSECURE_DEFAULTS=1

# ── HSM (SoftHSM2 dev) ─────────────────────────────────────────────────
SOFTHSM2_CONF=/hsm/tokens/softhsm2.conf
HSM_ALLOWED_MODULE_DIRS=/usr/lib,/usr/local/lib,/lib

# ── Production flags ──────────────────────────────────────────────────
# COOKIE_SECURE=1  # production ONLY — breaks localhost over plain HTTP.
